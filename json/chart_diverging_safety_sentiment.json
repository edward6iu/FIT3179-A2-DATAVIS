{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Advanced Idiom - Diverging Stacked Bar Chart. Community cycling interest and safety barriers across Melbourne demographics using the Roger Geller typology from Monash University active transport research (Pearson et al. 2022, Journal of Transport & Health, ScienceDirect, N = 3,993). Centred at 0% to contrast the uninterested cohort against the massive 'interested but concerned' near-market.",
  "title": {
    "text": "78% of Melburnians want to ride, but require safe, protected infrastructure",
    "subtitle": "Victorian adult cycling interest typology across demographics \u2013 Pearson et al. (2022, ScienceDirect, N = 3,993)."
  },
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/safety_perception_likert.csv"
  },
  "transform": [
    {
      "calculate": "datum.order == 1 ? -datum.pct : 0",
      "as": "neg_start"
    },
    {
      "calculate": "datum.order >= 2 ? datum.pct : 0",
      "as": "pos_pct"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "pos_pct",
          "as": "pos_cum"
        }
      ],
      "groupby": [
        "cohort"
      ],
      "sort": [
        {
          "field": "order",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.order == 1 ? -datum.pct : (datum.pos_cum - datum.pct)",
      "as": "x_start"
    },
    {
      "calculate": "datum.order == 1 ? 0 : datum.pos_cum",
      "as": "x_end"
    },
    {
      "calculate": "datum.order == 4 && datum.cohort == 'Female Residents' ? '83.2% near-market (highest)' : (datum.order == 4 && datum.cohort == 'Overall (Greater Melbourne)' ? '78.4% want to ride if safe' : (datum.order == 4 && datum.cohort == 'Outer Melbourne' ? '81.4% latent interest' : ''))",
      "as": "callout"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 1.5,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.65
        },
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "cohort",
          "type": "nominal",
          "title": null,
          "sort": [
            "Female Residents",
            "Outer Melbourne",
            "Middle Melbourne",
            "Overall (Greater Melbourne)",
            "Inner Melbourne",
            "Male Residents"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelLimit": 180,
            "labelFontWeight": 600
          }
        },
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "title": "\u2190 Uninterested ('No Way No How')  |  Potential & Active Riders ('Interested but Concerned' / Confident) \u2192",
          "scale": {
            "domain": [
              -25,
              115
            ]
          },
          "axis": {
            "values": [
              -20,
              -10,
              0,
              20,
              40,
              60,
              80
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "x2": {
          "field": "x_end"
        },
        "color": {
          "field": "typology",
          "type": "nominal",
          "title": "Geller Cycling Typology",
          "sort": [
            "No Way No How",
            "Interested but Concerned",
            "Enthused & Confident",
            "Strong & Fearless"
          ],
          "scale": {
            "domain": [
              "No Way No How",
              "Interested but Concerned",
              "Enthused & Confident",
              "Strong & Fearless"
            ],
            "range": [
              "#94a3b8",
              "#0d9488",
              "#2dd4bf",
              "#0f766e"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "cohort",
            "type": "nominal",
            "title": "Demographic Cohort"
          },
          {
            "field": "typology",
            "type": "nominal",
            "title": "Typology Category"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Population Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.callout != ''"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10.5,
        "fontWeight": 600,
        "fill": "#0f766e"
      },
      "encoding": {
        "y": {
          "field": "cohort",
          "type": "nominal",
          "sort": [
            "Female Residents",
            "Outer Melbourne",
            "Middle Melbourne",
            "Overall (Greater Melbourne)",
            "Inner Melbourne",
            "Male Residents"
          ]
        },
        "x": {
          "field": "x_end",
          "type": "quantitative"
        },
        "text": {
          "field": "callout"
        }
      }
    }
  ]
}